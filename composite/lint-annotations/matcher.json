{
    "problemMatcher": [
        {
            "owner": "kestra-lint-compact",
            "pattern": [
                {
                    "regexp": "^(.+): line (\\d+), col (\\d+), (error|warning) - (.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            ]
        }
    ]
}
