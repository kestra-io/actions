{
  "name": "@kestra-io/otel-core",
  "private": true,
  "description": "Shared, unpublished library: deterministic trace/span ids, OTLP builders/exporters, and GitHub Jobs API helpers used by both actions/otel-instrument and actions/otel-export-trace. Not a GitHub Action itself (no action.yml, no dist/) — imported by relative path.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "type": "module",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@grpc/grpc-js": "^1.14.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
